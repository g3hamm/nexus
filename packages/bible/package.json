{
  "name": "@nexus/bible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scripture lookup and in-message reference detection. The World English Bible ships with the package; API.Bible optional.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./detect": {
      "types": "./dist/detect.d.ts",
      "import": "./dist/detect.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0",
    "bible:load": "tsx src/load.ts"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "tsx": "^4.20.6"
  }
}
