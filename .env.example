# ─────────────────────────────────────────────────────────────────────────────
# Nexus — environment configuration
# Copy to `.env.local` and fill in. Never commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Use the POOLED connection string for the app, and require TLS.
# Neon: https://console.neon.tech → Connection Details → Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/nexus?sslmode=require"

# ── Encryption ───────────────────────────────────────────────────────────────
# Which key-management backend wraps per-conversation data keys.
#   "local" — dev only; master key read from NEXUS_MASTER_KEY below
#   "aws"   — production; master key stays inside AWS KMS and never leaves it
NEXUS_KMS_PROVIDER="local"

# Dev master key. Generate one with:  openssl rand -base64 32
# In production leave this UNSET and use NEXUS_KMS_PROVIDER="aws".
NEXUS_MASTER_KEY=""

# Trial deployments only. Lets the app boot in production with the master key
# above instead of a real KMS. Warns loudly on every start. Never set this
# once real people are having conversations. See docs/deploying.md.
NEXUS_ALLOW_INSECURE_LOCAL_KMS=""

# Production KMS (only when NEXUS_KMS_PROVIDER="aws")
AWS_KMS_KEY_ID=""
AWS_REGION="us-east-1"

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which adapter backs the LLM port. Swapping this swaps every AI flow at once.
NEXUS_LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# ── Realtime (LiveKit) ───────────────────────────────────────────────────────
# LiveKit Cloud: https://cloud.livekit.io → Settings → Keys
# The browser never reads these — it receives a scoped token and the URL from
# /api/conversations/[id]/token, so there is no public LiveKit variable.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signs volunteer/admin session cookies and seeker session tokens.
# Generate with:  openssl rand -base64 32
NEXUS_SESSION_SECRET=""

# ── Bible (optional) ─────────────────────────────────────────────────────────
# Public-domain translations ship with the app and need no key.
# Set this only to unlock API.Bible's wider language catalogue.
# https://scripture.api.bible
API_BIBLE_KEY=""
